# WebSurfaceHQ — .env.example
# ---------------------------------------------------------------------------
# Copy to .env (frontend: apps/web/.env.local, API: apps/api/.env) and fill in
# REAL values. NEVER commit a filled-in .env — .gitignore excludes .env* except
# this file. NEVER put a real key, token, password, or URL in this file: every
# value below is a placeholder (change-me / your-project / example.com).
# The app must refuse to start with a clear message if a required variable is
# missing (playbook rule). Required vs optional is marked per variable.
#
# PHASE 0 NOTE (review fix): the scaffold consumes exactly ONE variable today —
# ENVIRONMENT (apps/api/app/core/config.py). Every other variable below is
# documented now so Week 1+ code has one place to look, but is NOT yet read by
# any code: CORS_ORIGINS, LOG_LEVEL, API_HOST/API_PORT, all SUPABASE_*,
# UPSTASH_*/CELERY_*, GEMINI/GROQ, NVD, SENTRY_*, RAZORPAY/LEMONSQUEEZY/
# STRIPE, EMAIL_* are wired in as their features land (Week 1: Supabase/CORS/
# LOG_LEVEL/Sentry; Week 2: Celery/Redis; Week 3: Gemini/Groq). Do not assume a
# variable is live just because it is listed here — setting LOG_LEVEL=DEBUG
# today silently still logs INFO. There is deliberately NO generic REDIS_URL:
# the broker is CELERY_BROKER_URL and the Upstash REST endpoint is
# UPSTASH_REDIS_REST_URL.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Supabase project URL and keys. The project EXISTS (websurfacehq, ref
# dpwfshafzyxyfoktsggo, Singapore, created 11 Nov 2026). Real values go
# ONLY in gitignored local env files (apps/api/.env, apps/web/.env.local)
# — never in this file or any committed file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=change-me-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=change-me-supabase-service-role-key
# Service-role key is server-only. It must NEVER appear in frontend code,
# the frontend bundle, or any committed file.
SUPABASE_JWT_SECRET=change-me-supabase-jwt-secret
# Used by the API to verify Supabase JWTs. Server-only.

# --- API (required) --------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Public base URL of the deployed API (Render URL until the custom domain lands).
API_PUBLIC_URL=https://your-api.onrender.com
# Comma-separated list of allowed browser origins (CORS). No wildcard in prod.
CORS_ORIGINS=https://your-domain.example.com,http://localhost:3000
# Trust X-Forwarded-For for the client IP (auth rate limiting)? true ONLY
# when the app runs behind a trusted reverse proxy that is the sole ingress
# (Render in production). NEVER true in dev or when directly exposed — an
# attacker can spoof XFF to mint fresh per-IP buckets or lock a victim out
# (M1 review fix). Default false.
TRUST_X_FORWARDED_FOR=false
# Environment name: development | staging | production. Drives Sentry env,
# logging level, and whether /docs (OpenAPI) is exposed.
# PRODUCTION ON RENDER: set ENVIRONMENT=production — /docs and /redoc are
# disabled unless this is production, and the fail-fast secret check only
# runs in staging/production (L11 review fix: a forgotten ENVIRONMENT
# would leave /docs public AND skip the secret check).
ENVIRONMENT=development
# Secret for signing internal tokens (e.g. report share links). Random 32+ bytes.
INTERNAL_SIGNING_SECRET=change-me-random-32-bytes-minimum
# Log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Frontend (required for apps/web) --------------------------------------
# Public Supabase URL + anon key for the browser. Anon key is safe to expose;
# the service-role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me-supabase-anon-key
# Public base URL of the frontend (Vercel URL until the custom domain lands).
NEXT_PUBLIC_APP_URL=https://your-domain.example.com
# Public API base URL the browser calls.
NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# --- Queue: Celery + Upstash Redis (required for API + workers) ------------
# Upstash Redis REST URL + token (broker, result backend, rate-limit store).
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=change-me-upstash-token
# Celery broker URL (Redis). Same Upstash instance as above in MVP.
CELERY_BROKER_URL=redis://default:change-me@your-redis.upstash.io:6379/0
CELERY_RESULT_BACKEND=redis://default:change-me@your-redis.upstash.io:6379/0

# --- Scanner agent + tools (required for workers) ---------------------------
# Path to the Go scanner-agent binary on the worker (built in packages/).
SCANNER_AGENT_BIN=/app/bin/scanner-agent
# Directory holding the curated Nuclei templates (200 for MVP, not the full 8,000).
NUCLEI_TEMPLATES_DIR=/app/nuclei-templates
# Max outbound requests/second per target domain (politeness cap; never raise
# to evade a block — back off instead).
SCAN_MAX_RPS_PER_TARGET=5
# Max concurrent connections per target domain.
SCAN_MAX_CONCURRENT_PER_TARGET=2
# Max requests per scan on the Free plan (quota; plan limits are data, this is the cap).
SCAN_MAX_REQUESTS_FREE=1000

# --- AI triage: Gemini / Groq (required from Week 3; optional before) ------
# Primary triage LLM. Get a free-tier key from Google AI Studio.
GEMINI_API_KEY=change-me-gemini-api-key
# Fallback triage LLM. Get a free-tier key from Groq.
GROQ_API_KEY=change-me-groq-api-key
# Max LLM calls per scan (cost control; Medium+ findings only).
TRIAGE_MAX_LLM_CALLS_PER_SCAN=50

# --- Enrichment feeds (optional; free, no key for most) ---------------------
# NVD API 2.0 key (free). Raises the rate limit from 5 to 50 req/30s.
# Without a key the nightly job still works, just slower.
NVD_API_KEY=change-me-nvd-api-key-optional
# KEV + EPSS feed URLs (public; override only if the upstream URL changes).
KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_FEED_URL=https://epss.cyberdb.cloud/epss_scores-current.csv.gz

# --- Error tracking + uptime (required from Week 1) -------------------------
# Sentry DSN for the API/worker. Separate DSNs for staging vs production.
SENTRY_DSN_API=change-me-sentry-dsn-api
# Sentry DSN for the frontend (NEXT_PUBLIC_ so the browser can send events).
NEXT_PUBLIC_SENTRY_DSN=change-me-sentry-dsn-web
# UptimeRobot keep-alive: the 14-min ping hits /health; no secret needed.
# UPTIME_ROBOT_URL is not a variable — configure the ping in UptimeRobot itself.

# --- Billing (optional until Week 4 / Month 2) ------------------------------
# Razorpay (India: UPI, cards, netbanking). Keys from the Razorpay dashboard.
RAZORPAY_KEY_ID=change-me-razorpay-key-id
RAZORPAY_KEY_SECRET=change-me-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=change-me-razorpay-webhook-secret
# Lemon Squeezy (global merchant of record). Signing secret verifies webhooks.
LEMONSQUEEZY_API_KEY=change-me-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=change-me-lemonsqueezy-webhook-secret
# Stripe (later, for usage-based API billing). Not needed for MVP.
STRIPE_SECRET_KEY=change-me-stripe-secret-key-optional
STRIPE_WEBHOOK_SECRET=change-me-stripe-webhook-secret-optional

# --- Email (optional until transactional email lands, Month 2) --------------
# Transactional email provider (e.g. Resend). SPF/DKIM/DMARC must be set on the
# sending domain before any email is sent, or mail lands in spam.
EMAIL_PROVIDER_API_KEY=change-me-email-provider-key-optional
EMAIL_FROM_ADDRESS=noreply@your-domain.example.com
